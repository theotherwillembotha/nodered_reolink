{
  "name": "@theotherwillembotha/node-red-reolink",
  "version": "0.1.0",
  "description": "Node-RED integration for Reolink IP cameras and NVRs — control spotlights, sirens, receive motion events, and capture snapshots.",
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "author": "Willem Botha (@theotherwillembotha)",
  "license": "ISC",
  "keywords": [
    "node-red",
    "reolink",
    "camera",
    "ip-camera",
    "cctv",
    "nvr",
    "surveillance",
    "snapshot",
    "motion"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run clean && tsc && npm run generate-nodes && npm run copy-files",
    "clean": "rm -rf ./build",
    "generate-nodes": "node build/GenerateNodes.js",
    "copy-files": "cp -r ./icons ./build/"
  },
  "files": [
    "build/",
    "icons/",
    "documentation/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theotherwillembotha/nodered_reolink.git"
  },
  "bugs": {
    "url": "https://github.com/theotherwillembotha/nodered_reolink/issues"
  },
  "homepage": "https://github.com/theotherwillembotha/nodered_reolink#readme",
  "engines": {
    "node": ">=18",
    "nodered": ">=4.0.0"
  },
  "dependencies": {
    "@theotherwillembotha/node-red-plugincore": "^0.1.0",
    "axios": "^1.9.0",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "@theotherwillembotha/node-red-plugincore": "../nodered_plugincore",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.15.16",
    "@types/node-red": "~1.3.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "reolink": "./build/Nodes.js"
    },
    "plugins": {
      "reolink": "./build/Plugins.js"
    }
  }
}
